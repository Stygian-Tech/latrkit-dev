# LatrKit developer console
# Drives the non-production ribbon (src/components/EnvironmentBanner.tsx):
#   local — yellow LOCAL banner; dev/test — red DEV/TEST banner; prod — hidden
# Unset during `next dev` → local; Vercel production → prod; preview → dev
# local = loopback dev on 127.0.0.1; test/dev/prod = hosted OAuth + gateway heuristics
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_LATR_GATEWAY_URL=http://127.0.0.1:8080

# Staging (testing.latrkit.dev): NEXT_PUBLIC_APP_ENV=test
# OAuth uses gateway-hosted client metadata (public API) when the SPA is deployment-protected,
# same pattern as testing.latr.link → api.testing.latr.link/oauth/client-metadata.json.
# Gateway must set OAUTH_LATRKIT_PUBLIC_ORIGIN=https://testing.latrkit.dev
# If OAUTH_GATEWAY_REQUIRE_KNOWN_CLIENT=true on the gateway, allowlist must include:
# https://api.testing.latr.link/oauth/latrkit-client-metadata.json
# Only override client_id on unprotected hosts (latrkit.dev):
# NEXT_PUBLIC_ATPROTO_CLIENT_ID=https://latrkit.dev/client-metadata.json

# When your signed-in DID matches, the Official clients section is shown
# NEXT_PUBLIC_OFFICIAL_CLIENT_DID=did:plc:your-handle
