# LatrKit developer console (latrkit.dev)
# local = loopback dev on 127.0.0.1; test/dev/prod = hosted OAuth + gateway heuristics
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_LATR_GATEWAY_URL=http://127.0.0.1:8080

# Loopback OAuth is automatic on 127.0.0.1. Hosted deploys derive client metadata from the site origin.
# Override only when needed (custom domain, split metadata host, etc.):
# NEXT_PUBLIC_ATPROTO_CLIENT_ID=https://latrkit.dev/client-metadata.json
# NEXT_PUBLIC_ATPROTO_CLIENT_ID=https://testing.stygiantech.dev/client-metadata.json

# When your signed-in DID matches, the Official clients section is shown
# NEXT_PUBLIC_OFFICIAL_CLIENT_DID=did:plc:your-handle
